# For SQL Server, install the Microsoft ODBC Driver 18 for SQL Server.
# URL-encode special characters in username/password.
# Example (SQL Server authentication):
DATABASE_URL=mssql+pyodbc://USERNAME:PASSWORD@SERVER_NAME/DATABASE_NAME?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# For Windows integrated authentication, example:
# DATABASE_URL=mssql+pyodbc://@SERVER_NAME/DATABASE_NAME?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes

SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=1
